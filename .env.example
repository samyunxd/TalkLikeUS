# Required: Server-side Gemini API key from Google AI Studio (AIza... or AQ....).
# On Vercel: add GEMINI_API_KEY in Project Settings -> Environment Variables (no quotes, Application restrictions = None), then Redeploy.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini text model (automatically falls back if unavailable on your key).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Public application URL.
# APP_URL=https://your-project.vercel.app
